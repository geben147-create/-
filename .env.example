# 복사해서 ~/.config/last30days/.env 또는 셸 프로필(~/.zshrc, ~/.bashrc)에 export 하세요.
# 전부 선택사항입니다. 없어도 yt-dlp / Playwright / agent-browser / OCR / Whisper 는 그대로 동작합니다.

# Brave Search MCP + last30days 웹검색 (무료 티어)  https://brave.com/search/api/
BRAVE_API_KEY=

# Firecrawl MCP (크롤링/스크레이핑, 무료 크레딧)  https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=

# claude-video-vision 플러그인 Gemini 백엔드 (무료)  https://aistudio.google.com/apikey
GEMINI_API_KEY=

# last30days 선택 소스
OPENAI_API_KEY=            # Codex CLI 로그인 대신 키 사용 시 / last30days 요약
PERPLEXITY_API_KEY=        # https://www.perplexity.ai/settings/api
SCRAPECREATORS_API_KEY=    # TikTok/Instagram/Threads  https://scrapecreators.com
YOUTUBE_API_KEY=           # (선택) YouTube Data API v3 — 댓글/채널 통계용  https://console.cloud.google.com/apis/credentials
